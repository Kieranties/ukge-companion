---
interface Game {
  name: string;
  image?: string | null;
  description?: string | null;
}
interface Props {
  games?: Game[];
  exhibitorName?: string;
}
const { games = [], exhibitorName = '' } = Astro.props;
if (!games || games.length === 0) return null as any;

function bggSearchUrl(name: string): string {
  return `https://boardgamegeek.com/geeksearch.php?action=search&objecttype=boardgame&q=${encodeURIComponent(name)}`;
}
---
<details class="ukge-games">
  <summary>{games.length} game{games.length === 1 ? '' : 's'} on their UKGE listing</summary>
  <ul class="ukge-games-list">
    {games.map((g) => (
      <li>
        {g.image && <img class="ukge-game-thumb" src={g.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}
        <div class="ukge-game-body">
          <a class="ukge-game-name tag-chip" href={bggSearchUrl(g.name)} target="_blank" rel="noopener" title={`Look up ${g.name} on BoardGameGeek`}>{g.name} <span class="ukge-bgg-arrow" aria-hidden="true">↗</span></a>
          {g.description && <p class="ukge-game-desc">{g.description}</p>}
        </div>
      </li>
    ))}
  </ul>
</details>
