---
import BggLink from './BggLink.astro';

interface Game {
  name: string;
  image?: string | null;
  description?: string | null;
}
interface Props {
  games?: Game[];
  exhibitorName?: string;
}
const { games = [], exhibitorName = '' } = Astro.props;
if (!games || games.length === 0) return null as any;
---
<details class="ukge-games">
  <summary>{games.length} game{games.length === 1 ? '' : 's'} on their UKGE listing</summary>
  <ul class="ukge-games-list">
    {games.map((g) => (
      <li>
        {g.image && <img class="ukge-game-thumb" src={g.image} alt="" loading="lazy" referrerpolicy="no-referrer" />}
        <div class="ukge-game-body">
          <span class="ukge-game-name">{g.name}</span>
          <BggLink name={g.name} />
          {g.description && <p class="ukge-game-desc">{g.description}</p>}
        </div>
      </li>
    ))}
  </ul>
</details>
