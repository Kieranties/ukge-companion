---
// Shared booth-tool buttons used by every card kind. Client wiring is done
// once globally by cards.ts — these are just markup. The plan button cycles:
//   "+ Add to plan" → "Planned · Any day" → "Friday" → "Saturday" → "Sunday"
// Once it's anything other than the unplanned default, the booth appears in
// the Route tab.
//
// The "Hide" button (internally `skip`) keeps the booth out of the default
// view; toggle "Show hidden" in the filter tray to surface them again.
---
<div class="booth-tools">
  <button class="booth-btn plan-btn" data-action="open-plan-picker" type="button">+ Add to plan</button>
  <button class="booth-btn visit-btn" data-action="toggle-visit" type="button">Mark as visited</button>
  <button class="booth-btn buy-btn" data-action="toggle-buy" type="button" title="Open the shopping list editor">🛒 Buy</button>
  <button class="booth-btn skip-btn" data-action="toggle-skip" type="button">Hide</button>
  <button class="booth-btn notes-toggle" data-action="toggle-notes" type="button">Notes</button>
  <div class="notes-area hidden" data-role="notes">
    <textarea data-role="notes-text" placeholder="Notes — saved on your device only"></textarea>
  </div>
  <div class="shopping-editor hidden" data-role="shopping-editor">
    <ul class="shopping-list" data-role="shopping-items"></ul>
    <form class="shopping-add" data-action="add-buy-item">
      <input type="text" data-role="shopping-input" placeholder="Add a game to buy…" />
      <input type="number" data-role="shopping-price" class="shopping-price" placeholder="£" step="0.01" min="0" inputmode="decimal" aria-label="Price in GBP" />
      <button type="submit" class="shopping-add-btn">+ Add</button>
    </form>
  </div>
</div>
