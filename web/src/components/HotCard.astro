---
import AwardBadge from './AwardBadge.astro';
interface Props {
  hot: {
    rank: number;
    game: {
      bggId: string;
      name: string;
      year?: string | null;
      geekRating?: number | null;
      thumb?: string | null;
      categories?: string[];
      description?: string | null;
      award?: any;
    };
    exhibitors: Array<{
      exhibitor: { slug: string; name: string; hall?: string; stand?: string };
      publisher: string;
    }>;
  };
}
const { hot } = Astro.props;
const g = hot.game;
const bggUrl = `https://boardgamegeek.com/boardgame/${g.bggId}`;
const cats = (g.categories || []).slice(0, 4);
const catsString = cats.join(' · ');
const haystack = [
  g.name,
  String(g.year || ''),
  cats,
  ...hot.exhibitors.map((me) => me.exhibitor.name),
]
  .join(' ')
  .toLowerCase();
---
<article
  class="card hot-card"
  data-kind="hot-game"
  data-slug={`hot-${g.bggId}`}
  data-name={(g.name || '').toLowerCase()}
  data-categories={catsString.toLowerCase()}
  data-hall=""
>
  <a class="hot-thumb" href={bggUrl} target="_blank" rel="noopener" title="View on BoardGameGeek">
    {g.thumb ? <img src={g.thumb} alt="" loading="lazy" /> : <div class="no-thumb">·</div>}
  </a>
  <div class="hot-body">
    <header class="card-head" style="grid-template-columns: 30px 1fr">
      <div class="card-rank">#{hot.rank}</div>
      <div class="card-title">
        <h3><a href={bggUrl} target="_blank" rel="noopener">{g.name}</a></h3>
        <div class="hot-meta">{g.year} · BGG {g.geekRating ? g.geekRating.toFixed(2) : '—'}</div>
      </div>
    </header>
    <div class="card-cats" style="margin-top:6px">
      {cats.map((c) => <button class="tag-chip" data-tag-kind="category" data-tag-value={c} type="button">{c}</button>)}
      <AwardBadge award={g.award} />
    </div>
    {g.description && <p class="card-desc hot-desc">{g.description}</p>}
    <div class="hot-venues-label">Published by:</div>
    {hot.exhibitors.slice(0, 3).map((me) => {
      const u = `https://www.ukgamesexpo.co.uk/whats-on/show/exhibitors/${me.exhibitor.slug}/`;
      const mapU = me.exhibitor.stand ? `https://www.ukgamesexpo.co.uk/whats-on/show/exhibitors/map/#${me.exhibitor.stand}` : null;
      return (
        <div class="hot-venue">
          <a class="ex-name" href={u} target="_blank" rel="noopener">{me.exhibitor.name}</a>
          {mapU ? (
            <a class="ex-loc-tag stand" href={mapU} target="_blank" rel="noopener" title={`Find ${me.exhibitor.stand} on the UKGE map`}>
              {me.exhibitor.hall} {me.exhibitor.stand}
            </a>
          ) : (
            <span class="ex-loc-tag">{me.exhibitor.hall}</span>
          )}
        </div>
      );
    })}
  </div>
</article>
