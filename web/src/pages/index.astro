---
import '../styles/global.css';
import data from '../data/dashboard.json';
import ExhibitorCard from '../components/ExhibitorCard.astro';
import DiscoveryCard from '../components/DiscoveryCard.astro';
import AllVendorCard from '../components/AllVendorCard.astro';
import HotCard from '../components/HotCard.astro';
import EventCard from '../components/EventCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const eventCategoryCounts: { cat: string; n: number }[] = (() => {
  const counts: Record<string, number> = {};
  for (const e of (data.events as any[]) || []) {
    const c = e.category || 'Other';
    counts[c] = (counts[c] || 0) + 1;
  }
  return Object.entries(counts)
    .sort((a, b) => b[1] - a[1])
    .map(([cat, n]) => ({ cat, n }));
})();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#fdf8ed" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="manifest" href={`${base}/manifest.json`} />
  <link rel="icon" type="image/svg+xml" href={`${base}/icon.svg`} />
  <link rel="apple-touch-icon" href={`${base}/icon.svg`} />
  <title>UK Games Expo 2026 Companion · {data.username}</title>
  <script is:inline>
    // Apply theme before first paint to avoid a light/dark flash.
    // Mirrored in src/scripts/theme.ts — keep both in sync.
    (function () {
      try {
        var stored = localStorage.getItem('ukge-companion-theme');
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (systemDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
</head>
<body>

<header class="site-header">
  <div class="container">
    <div>
      <h1>UK Games Expo 2026 Companion</h1>
      <div class="sub">
        29–31 May · NEC Birmingham · Built for
        <a href={`https://boardgamegeek.com/collection/user/${data.username}`} target="_blank" rel="noopener">
          <strong>{data.username}</strong>
        </a>
        from your BGG collection
      </div>
    </div>
    <div class="header-actions">
      <div class="header-menu" id="header-menu">
        <button class="icon-btn" id="install-btn" title="Install as an app"><span class="ico">⬇</span> Install</button>
        <button class="icon-btn" id="share-btn" title="Generate a shareable link"><span class="ico">↗</span> Share</button>
        <button class="icon-btn theme-btn" id="theme-toggle" title="Toggle light/dark">
          <span class="ico theme-light">☀</span><span class="ico theme-dark">☾</span>
          <span class="theme-light">Light</span><span class="theme-dark">Dark</span>
        </button>
        <button class="icon-btn" id="export-btn" title="Export plan as markdown"><span class="ico">⤓</span> Export</button>
      </div>
      <button class="icon-btn header-menu-btn" id="header-menu-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="header-menu" title="More"><span class="ico">⋮</span></button>
    </div>
  </div>
</header>

<div class="sticky-stack">
<div class="bar" id="search-bar">
  <div class="container">
    <div class="search-row">
      <input id="global-q" type="search" placeholder="Search exhibitor, game, publisher, award, hall…" autocomplete="off" inputmode="search" />
      <button class="filter-toggle pill" id="filter-toggle" type="button" aria-expanded="false" aria-controls="filter-tray">
        <span>Filters</span>
        <span class="filter-count hidden" id="filter-count">0</span>
      </button>
    </div>
    <div class="filter-tray" id="filter-tray" data-open="false">
      <div class="pill-row">
        <span class="label">Show:</span>
        <span class="pills">
          <button class="pill status-pill active" data-status="all">All</button>
          <button class="pill status-pill" data-status="unvisited">Unvisited</button>
          <button class="pill status-pill" data-status="visited">Visited</button>
          <button class="pill status-pill" data-status="revisit">Revisit ★</button>
          <button class="pill status-pill" data-status="buy">Buy 🛒</button>
          <button class="pill" id="hide-skipped" type="button">Show hidden</button>
        </span>
      </div>
      <div class="pill-row day-row">
        <span class="label">Day:</span>
        <span class="pills">
          <button class="pill day-pill active" data-day="any">Any</button>
          <button class="pill day-pill" data-day="fri">Fri</button>
          <button class="pill day-pill" data-day="sat">Sat</button>
          <button class="pill day-pill" data-day="sun">Sun</button>
        </span>
      </div>
      <div class="pill-row day-row">
        <span class="label">Refine:</span>
        <span class="pills">
          <button class="pill refine-btn" id="open-filters-panel" type="button">+ Add filter…</button>
        </span>
      </div>
    </div>
  </div>
</div>

<nav class="bar" id="tab-bar">
  <div class="container">
    <div class="tabs-inner" id="tabs">
      <button class="tab active" data-tab="for-you">For you <span class="badge">{data.stats.matched_exhibitors}</span></button>
      <button class="tab" data-tab="hot">Hot games <span class="badge">{data.stats.hot_count}</span></button>
      <button class="tab" data-tab="events">Events <span class="badge">{data.stats.events_count}</span></button>
      <button class="tab" data-tab="route">Route</button>
      <button class="tab" data-tab="shopping">Shopping <span class="badge hidden">0</span></button>
      <button class="tab" data-tab="library">Library <span class="badge hidden">0</span></button>
      <button class="tab" data-tab="discover">Discover <span class="badge">{data.stats.discovery_count}</span></button>
      <button class="tab" data-tab="browse">Browse all <span class="badge">{data.stats.total_exhibitors}</span></button>
      <button class="tab" data-tab="info">Info</button>
    </div>
  </div>
</nav>
</div>

<main class="container">
  <div class="active-tag-bar hidden" id="active-tag-bar"></div>
  <div class="search-results" id="search-results"></div>

  <div class="panel active" data-panel="for-you">
    <section>
      <div class="section-head">
        <h2>Top recommendations <span class="count">— {data.stats.matched_exhibitors} exhibitors</span></h2>
        <p class="lede">Ranked by publisher matches against your BGG collection — weighted by plays, dampened for big generic publishers, with a small bonus for category overlap. <a href="#info">See your taste signal →</a></p>
      </div>
      <div class="card-grid two-up">
        {data.recommendations.map((rec) => <ExhibitorCard rec={rec} />)}
      </div>
    </section>
  </div>

  <div class="panel" data-panel="hot">
    <section>
      <div class="section-head">
        <h2>Games to look out for <span class="count">— {data.stats.hot_count} of BGG's hot games have publishers at the show</span></h2>
        <p class="lede">BGG's current hot list × UKGE exhibitor publishers. Click a thumbnail for BGG reviews.</p>
      </div>
      <div class="card-grid two-up">
        {data.hot_at_show.map((hot) => <HotCard hot={hot} />)}
      </div>
    </section>
  </div>

  <div class="panel" data-panel="events">
    <section>
      <div class="section-head">
        <h2>Events <span class="count">— {data.stats.events_count} scheduled · {data.stats.events_linked} linked to a stand</span></h2>
        <p class="lede">Tournaments, RPG sessions, seminars, meet-and-greets, and live entertainment. Day pill above filters this too; category pill below scopes by event type. Click a stand chip on any event to open the publisher card in-app.</p>
      </div>
      <div class="event-cat-row" id="event-cat-row">
        <button class="pill cat-pill active" data-cat="all" type="button">All <span class="event-cat-count">{data.stats.events_count}</span></button>
        {eventCategoryCounts.map(({ cat, n }) => (
          <button class="pill cat-pill" data-cat={cat} type="button">{cat} <span class="event-cat-count">{n}</span></button>
        ))}
      </div>
      <div class="event-grid" id="event-grid">
        {(data.events || []).map((e: any) => <EventCard event={e} />)}
      </div>
      <p class="event-empty hidden" id="event-empty">Nothing matches the current filters.</p>
    </section>
  </div>

  <div class="panel" data-panel="route">
    <section>
      <div class="section-head">
        <h2>Route plan <span class="count">— matched stands grouped by hall</span></h2>
        <p class="lede">Sorted by stand number — roughly the walking order. Updates as you mark visits.</p>
      </div>
      <div id="route-plan"></div>
    </section>
  </div>

  <div class="panel" data-panel="shopping">
    <section>
      <div class="section-head">
        <h2>Shopping list</h2>
        <p class="lede">Stands you've flagged for buying. Add specific games per stand to keep track on the floor; tick them off as you go.</p>
      </div>
      <div id="shopping-list"></div>
    </section>
  </div>

  <div class="panel" data-panel="library">
    <section>
      <div class="section-head">
        <h2>Game library</h2>
        <p class="lede">Track games you'd like to borrow from the UKGE <a href="https://www.ukgamesexpo.co.uk/whats-on/show/board-game-library/" target="_blank" rel="noopener">Board Game Library</a> (1500+ titles, sponsored by Chance &amp; Counters). £10 deposit and photo ID at the desk. Add games here, then tick them off once you've played.</p>
      </div>
      <div id="library-list"></div>
    </section>
  </div>

  <div class="panel" data-panel="discover">
    <section>
      <div class="section-head">
        <h2>Discovery <span class="count">— {data.stats.discovery_count} publishers worth a look</span></h2>
        <p class="lede">Publishers at the expo who don't publish your games yet, but share categories and mechanics with your most-played titles.</p>
      </div>
      <div class="card-grid three-up">
        {data.discovery.map((rec) => <DiscoveryCard rec={rec} />)}
      </div>
    </section>
  </div>

  <div class="panel" data-panel="browse">
    <section>
      <div class="section-head">
        <h2>All {data.stats.total_exhibitors} exhibitors</h2>
        <p class="lede">Searchable from the bar above — by name, hall, category, anything in the description.</p>
      </div>
      <div class="card-grid three-up">
        {data.all_exhibitors.map((e) => <AllVendorCard exhibitor={e} />)}
      </div>
    </section>
  </div>

  <div class="panel" data-panel="info">
    <section>
      <div class="section-head">
        <h2>Your taste signal</h2>
        <p class="lede">Everything below is derived from your BGG collection. It feeds the recommendations on the For-you tab and the Discovery picks.</p>
      </div>
      <div class="taste-strip">
        <div class="taste-card">
          <div class="taste-v">{data.stats.total_games}</div>
          <div class="taste-k">games in collection</div>
          <div class="taste-sub">{data.stats.total_plays.toLocaleString()} plays logged</div>
        </div>
        <div class="taste-card">
          <div class="taste-v">{data.stats.coverage_pct}%</div>
          <div class="taste-k">of your collection is published here</div>
          <div class="taste-sub">{data.stats.matched_exhibitors} of {data.stats.total_exhibitors} exhibitors match</div>
        </div>
        <div class="taste-card">
          <div class="taste-v">{data.stats.hot_count}</div>
          <div class="taste-k">BGG hot games at the show</div>
          <div class="taste-sub">{data.stats.discovery_count} discovery picks beyond your collection</div>
        </div>
      </div>
      <div class="taste-tags">
        <div class="taste-tags-block">
          <h3>Top categories you play</h3>
          <div class="taste-chip-row">
            {(data.top_categories || []).slice(0, 8).map((c: any) => (
              <span class="taste-chip" title={`Weight ${c.weight}`}>{c.name}</span>
            ))}
          </div>
        </div>
        <div class="taste-tags-block">
          <h3>Top mechanics you play</h3>
          <div class="taste-chip-row">
            {(data.top_mechanics || []).slice(0, 8).map((m: any) => (
              <span class="taste-chip" title={`Weight ${m.weight}`}>{m.name}</span>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="section-head">
        <h2>Getting there</h2>
        <p class="lede">NEC Birmingham · North Avenue, Marston Green, Birmingham B40 1NT</p>
      </div>
      <div class="map-embed">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d19451.513922934297!2d-1.74065921038034!3d52.45307216404293!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4870b122e65d9dfd%3A0x1d0d8b24ea1e5be3!2sMarston%20Green%2C%20Birmingham%20B40%201NT!5e0!3m2!1sen!2suk!4v1779919982382!5m2!1sen!2suk"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="Map: NEC Birmingham"
        ></iframe>
        <div class="map-links">
          <a href="https://www.google.com/maps/dir/?api=1&destination=NEC+Birmingham+B40+1NT" target="_blank" rel="noopener">
            <svg class="brand-icon" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="#EA4335"/>
              <circle cx="12" cy="9" r="2.5" fill="#fff"/>
            </svg>
            Google Maps
          </a>
          <a href="https://maps.apple.com/?address=NEC+Birmingham+B40+1NT&dirflg=d" target="_blank" rel="noopener">
            <svg class="brand-icon" width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" fill="currentColor"/>
            </svg>
            Apple Maps
          </a>
          <a href="https://www.thenec.co.uk/visitors/getting-here/" target="_blank" rel="noopener">NEC travel info</a>
        </div>
      </div>
    </section>
    <section>
      <div class="section-head">
        <h2>Opening times</h2>
        <p class="lede">When each venue is open. Trade Hall closes earliest; gaming halls + library run later.</p>
      </div>
      <div class="hours-table-wrap">
      <table class="hours-table">
        <thead>
          <tr>
            <th>Venue</th>
            <th>Fri <span class="day-date">29 May</span></th>
            <th>Sat <span class="day-date">30 May</span></th>
            <th>Sun <span class="day-date">31 May</span></th>
          </tr>
        </thead>
        <tbody>
          <tr><th scope="row">Trade Hall</th><td>09:00 – 18:00</td><td>09:00 – 18:00</td><td>09:00 – 16:00</td></tr>
          <tr><th scope="row">Gaming &amp; Tournaments</th><td>09:00 – Midnight</td><td>09:00 – Midnight</td><td>09:00 – 18:00</td></tr>
          <tr><th scope="row">Board Game Library <span class="venue-sub">NEC</span></th><td>09:00 – 22:00</td><td>09:00 – 22:00</td><td>09:00 – 14:00</td></tr>
          <tr><th scope="row">Board Game Library <span class="venue-sub">Hilton</span></th><td>18:00 – 22:00</td><td>18:00 – 22:00</td><td>—</td></tr>
        </tbody>
      </table>
      </div>
      <p class="lede" style="margin-top:10px">
        <a href="https://www.ukgamesexpo.co.uk/plan/before-the-expo/expo-opening-hours/" target="_blank" rel="noopener">Full hours on the UKGE site</a> — including Hilton Hotel gaming, Board Game Library, and Thursday early access for select areas.
      </p>
    </section>
    <section>
      <div class="section-head">
        <h2>Hall map</h2>
        <p class="lede">UKGE blocks embedding their map, so the button opens it in a new tab.</p>
      </div>
      <div class="map-link-block">
        <a href="https://www.ukgamesexpo.co.uk/whats-on/show/exhibitors/map/" target="_blank" rel="noopener">
          <span style="font-size:18px">🗺</span> Open official UKGE map
        </a>
        <div style="margin-top: 16px; color: var(--ink-dim); font-size: 13px;">
          Halls used in 2026: Hall One · Hall Two · Hall Three · Hall Three A · Hall Four · Hall Five · Toy Fair
        </div>
      </div>
    </section>
  </div>

  <footer>
    Generated from BGG collection + UKGE exhibitor listing + BGG hotness.
    <a href="https://github.com/Kieranties/ukge-companion" target="_blank" rel="noopener">Source on GitHub</a>.
    Built {data.generated_at_iso}.
  </footer>
</main>

<!-- Share modal -->
<div class="modal" id="share-modal">
  <div class="modal-box">
    <h3>Share your plan</h3>
    <p style="margin: 0 0 10px; color: var(--ink-dim); font-size: 13px;">
      Anyone with this link sees your visited / buy / day-planned stands as a one-time import prompt. Notes are excluded by default.
    </p>
    <label style="display:flex; align-items:center; gap:8px; margin: 8px 0; font-size: 14px;">
      <input type="checkbox" id="share-include-notes" /> Include notes
    </label>
    <textarea id="share-text" readonly></textarea>
    <div class="modal-actions">
      <button id="share-copy" class="primary">Copy link</button>
      <button id="share-close">Close</button>
    </div>
  </div>
</div>

<!-- Import-from-share -->
<div class="modal" id="import-modal">
  <div class="modal-box">
    <h3>Import shared plan?</h3>
    <p id="import-summary" style="margin: 0 0 10px; color: var(--ink); font-size: 14px;"></p>
    <p style="margin: 0 0 10px; color: var(--ink-dim); font-size: 13px;">
      <strong>Merge</strong> keeps your existing entries and fills in blanks from the shared link. <strong>Replace</strong> overwrites your plan entirely.
    </p>
    <div class="modal-actions">
      <button id="import-cancel">Cancel</button>
      <button id="import-replace">Replace mine</button>
      <button id="import-merge" class="primary">Merge</button>
    </div>
  </div>
</div>

<!-- Export modal -->
<div class="modal" id="export-modal">
  <div class="modal-box">
    <h3>Export your plan as markdown</h3>
    <p style="margin: 0 0 10px; color: var(--ink-dim); font-size: 13px;">Copy into Obsidian, Slack, or wherever.</p>
    <textarea id="export-text" readonly></textarea>
    <div class="modal-actions">
      <button id="export-copy" class="primary">Copy to clipboard</button>
      <button id="export-close">Close</button>
    </div>
  </div>
</div>

<!-- Vendor card overlay — pops the exhibitor's existing card into a modal
     so booth tools stay reachable when a vendor link is clicked from
     contexts like Hot games. Body is filled by vendor-modal.ts. -->
<div class="modal vendor-modal" id="vendor-modal" aria-hidden="true">
  <div class="modal-box vendor-modal-box" role="dialog" aria-modal="true" aria-label="Booth details">
    <button class="vendor-modal-close" type="button" data-action="close-vendor-modal" aria-label="Close">×</button>
    <div class="vendor-modal-body" id="vendor-modal-body"></div>
  </div>
</div>

<!-- Event card overlay — pops the event's existing card into a modal so the
     Going toggle + notes stay reachable when an event is clicked from a
     vendor card. Body is filled by event-modal.ts. -->
<div class="modal vendor-modal" id="event-modal" aria-hidden="true">
  <div class="modal-box vendor-modal-box" role="dialog" aria-modal="true" aria-label="Event details">
    <button class="vendor-modal-close" type="button" data-action="close-event-modal" aria-label="Close">×</button>
    <div class="vendor-modal-body" id="event-modal-body"></div>
  </div>
</div>

<!-- Vendor event picker — opened from "+ Add event" on a vendor card. Body
     is rendered dynamically by event-picker.ts. -->
<div class="modal" id="vendor-event-picker" aria-hidden="true">
  <div class="modal-box vendor-event-picker-box" role="dialog" aria-modal="true" aria-label="Add event to vendor">
    <header class="event-picker-head">
      <h3 id="event-picker-title">Add event…</h3>
      <button type="button" data-action="close-vendor-event-picker" aria-label="Close" class="vendor-modal-close">×</button>
    </header>
    <input type="search" id="event-picker-search" placeholder="Search events at this hall…" autocomplete="off" inputmode="search" />
    <div class="event-picker-list" id="event-picker-list"></div>
    <p class="event-picker-empty hidden" id="event-picker-empty">No matching events. Clear the search to see every event at the show.</p>
    <label class="event-picker-scope">
      <input type="checkbox" id="event-picker-all-halls" /> Show events from every hall
    </label>
  </div>
</div>

<!-- Filters panel — opened from the "+ Add filter…" pill. Sheet on mobile,
     popover on desktop. Body is rendered dynamically by filters-panel.ts. -->
<div class="filters-panel" id="filters-panel" aria-hidden="true">
  <div class="filters-panel-backdrop" data-action="close-filters-panel"></div>
  <div class="filters-panel-sheet" role="dialog" aria-modal="true" aria-labelledby="filters-panel-title">
    <header class="filters-panel-head">
      <h3 id="filters-panel-title">Refine results</h3>
      <button class="filters-panel-close" type="button" data-action="close-filters-panel" aria-label="Close">×</button>
    </header>
    <div class="filters-panel-body" id="filters-panel-body"></div>
    <footer class="filters-panel-foot">
      <button class="filters-clear" type="button" data-action="clear-all-filters">Clear all</button>
      <button class="filters-done primary" type="button" data-action="close-filters-panel">Done</button>
    </footer>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  import '../scripts/main.ts';
</script>

</body>
</html>
